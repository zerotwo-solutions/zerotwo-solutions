---
interface Props { items: { name: string; path: string }[] }
const { items } = Astro.props;
---
<nav class="crumbs" aria-label="Breadcrumb">
  <ol role="list">
    {items.map((it, i) => (
      <li>
        {i < items.length - 1 ? <a href={it.path}>{it.name}</a> : <span aria-current="page">{it.name}</span>}
      </li>
    ))}
  </ol>
</nav>
<style>
  .crumbs ol { display: flex; flex-wrap: wrap; gap: 8px; font-size: var(--fs-xs); color: var(--text-3); font-family: var(--mono); }
  .crumbs li + li::before { content: "/"; margin-right: 8px; opacity: 0.5; }
  .crumbs a:hover { color: var(--text); }
  .crumbs [aria-current] { color: var(--text-2); }
</style>
