---
// "Real-time by default": a simulated options-flow stream on a zero-dependency Canvas 2D chart.
// A deterministic snapshot (SVG chart, tiles, tape) is server-rendered for no-JS and SEO.
import { caseBySlug } from "../../data/site";
import {
  BATCH,
  QUEUE_CAP,
  createSim,
  formatInt,
  makePrint,
  mulberry32,
  stepSim,
  triggerBurst,
  upcomingFridays,
  warmUp,
} from "../../scripts/live-market";
import Icon from "../Icon.astro";
import SectionHeader from "../SectionHeader.astro";

const opra = caseBySlug("real-time-options-flow-pipeline");
const caseHref = `/work/${opra?.slug ?? "real-time-options-flow-pipeline"}/`;

// Deterministic snapshot: steady flow, a market-open burst, then the drain
const sim = createSim(42);
warmUp(sim, 90);
triggerBurst(sim);
for (let i = 0; i < 60; i++) stepSim(sim);
const samples = sim.samples;
const last = samples[samples.length - 1]!;

// SVG fallback geometry (viewBox units; stretched to the chart box)
const VW = 1000;
const VH = 360;
const priceH = VH * 0.56;
const barsTop = priceH + 22;
const barsH = VH - barsTop - 8;
const prices = samples.map((s) => s.price);
const pMin = Math.min(...prices) - 0.2;
const pMax = Math.max(...prices) + 0.2;
const rMax = Math.max(48_000, ...samples.map((s) => s.rate)) * 1.12;
const step = VW / (samples.length - 1);
const pricePts = samples.map((s, i) => `${(i * step).toFixed(1)},${(12 + (1 - (s.price - pMin) / (pMax - pMin)) * (priceH - 12)).toFixed(1)}`);
const pricePath = `M${pricePts.join("L")}`;
const areaPath = `${pricePath}L${VW},${priceH}L0,${priceH}Z`;
const queuePath = `M${samples.map((s, i) => `${(i * step).toFixed(1)},${(barsTop + barsH - (s.queue / QUEUE_CAP) * barsH).toFixed(1)}`).join("L")}`;
const bars = samples.map((s, i) => {
  const h = (s.rate / rMax) * barsH;
  return { x: i * step - step * 0.31, y: barsTop + barsH - h, w: step * 0.62, h, burst: s.burst };
});

// Tape snapshot
const rand = mulberry32(2024);
const expiries = upcomingFridays(new Date());
const prints = Array.from({ length: 8 }, (_, i) => makePrint(rand, expiries, i < 3));

const tiles = [
  { key: "processed", label: "Events processed", value: formatInt(sim.processed), unit: "", sub: "simulated session total" },
  { key: "latency", label: "p99 latency", value: formatInt(sim.latency), unit: "ms", sub: "feed to WebSocket" },
  { key: "dropped", label: "Dropped messages", value: "0", unit: "", sub: "alert fires on any drop" },
];
---
<section id="live-market" class="section market" aria-label="Real-time market data demo" data-market data-phase="steady">
  <div class="container">
    <SectionHeader
      eyebrow="Real-time by default"
      title={`Market-open bursts, <span class="gradient-text">absorbed.</span>`}
      lead="A live simulation of the options-flow pipeline we run in production: 200 ms burst buckets, a bounded 50,000-item queue and 5,000-message batch writes. Trigger a market-open spike and watch the queue soak it up, then drain, with zero dropped messages."
    />

    <div class="market-grid" data-reveal>
      <div class="panel chart-panel">
        <header class="panel-head">
          <span class="feed"><span class="live-dot" aria-hidden="true"></span>options-flow · OPRA</span>
          <span class="rate"><span data-m="rate">{formatInt(last.rate)}</span> ev/s</span>
          <span class="state" data-m="state" aria-live="polite">Steady flow</span>
        </header>

        <div class="chart" data-market-chart>
          <svg class="chart-fallback" viewBox={`0 0 ${VW} ${VH}`} preserveAspectRatio="none" aria-hidden="true">
            <defs>
              <linearGradient id="lm-fill" x1="0" y1="0" x2="0" y2="1">
                <stop offset="0" stop-color="#4fd1c5" stop-opacity="0.28" />
                <stop offset="1" stop-color="#4fd1c5" stop-opacity="0" />
              </linearGradient>
            </defs>
            <path d={areaPath} fill="url(#lm-fill)" />
            <path d={pricePath} fill="none" stroke="#4fd1c5" stroke-width="1.75" vector-effect="non-scaling-stroke" />
            {bars.map((b) => (
              <rect x={b.x.toFixed(1)} y={b.y.toFixed(1)} width={b.w.toFixed(1)} height={b.h.toFixed(1)} fill={b.burst ? "rgba(245,165,36,0.85)" : "rgba(139,124,255,0.5)"} />
            ))}
            <path d={queuePath} fill="none" stroke="#f7f8f8" stroke-width="1.5" vector-effect="non-scaling-stroke" />
            <line x1="0" x2={VW} y1={barsTop} y2={barsTop} stroke="rgba(255,255,255,0.28)" stroke-dasharray="4 4" vector-effect="non-scaling-stroke" />
          </svg>
          <canvas
            role="img"
            aria-label="Simulated chart of underlying price, events per second in 200 millisecond buckets, and queue depth against a 50,000-item bound"
          ></canvas>
        </div>

        <ul class="legend" role="list">
          <li><i class="sw sw-price"></i>Underlying price</li>
          <li><i class="sw sw-rate"></i>Events per 200 ms bucket</li>
          <li><i class="sw sw-burst"></i>Burst bucket</li>
          <li><i class="sw sw-queue"></i>Queue depth vs 50k bound</li>
        </ul>

        <div class="panel-foot">
          <button type="button" class="btn btn--primary burst-btn" data-burst aria-disabled="false">
            <Icon name="bolt" size={16} /><span data-burst-label>Simulate market-open burst</span>
          </button>
          <span class="sim-tag">Simulated data</span>
        </div>
      </div>

      <div class="side">
        <dl class="tiles">
          {tiles.map((t) => (
            <div class:list={["tile", `tile--${t.key}`]}>
              <dt>{t.label}</dt>
              <dd>
                <span class="tile-value"><span data-m={t.key}>{t.value}</span>{t.unit && <small>{t.unit}</small>}</span>
                <span class="tile-sub">{t.sub}</span>
              </dd>
            </div>
          ))}
          <div class="tile tile--queue">
            <dt>Queue depth</dt>
            <dd>
              <span class="tile-value"><span data-m="queue">{formatInt(last.queue)}</span><small>/ {formatInt(QUEUE_CAP)}</small></span>
              <span class="meter" aria-hidden="true"><span data-m="queue-bar" style={`transform: scaleX(${(last.queue / QUEUE_CAP).toFixed(4)})`}></span></span>
              <span class="tile-sub"><span data-m="batches">{formatInt(sim.batches)}</span> batch writes of {formatInt(BATCH)}</span>
            </dd>
          </div>
        </dl>

        <div class="panel tape-panel">
          <header class="panel-head">
            <span class="feed">Options prints</span>
            <span class="sim-tag">Simulated data</span>
          </header>
          <ol class="tape" role="list" data-tape aria-label="Simulated options prints">
            {prints.map((p) => (
              <li>
                <span class="t-sym">{p.sym}</span>
                <span class="t-exp">{p.exp}</span>
                <span class:list={["t-k", p.strike.endsWith("C") ? "is-call" : "is-put"]}>{p.strike}</span>
                <span class="t-kind">{p.kind}</span>
                <span class="t-prem">{p.premium}</span>
                <span class:list={["t-side", `is-${p.side}`]}>{p.side}</span>
              </li>
            ))}
          </ol>
        </div>
      </div>
    </div>

    <p class="market-foot">
      Modeled on our production OPRA and dark pool pipeline: bounded queues, pipelined batch writes, alerts on any
      dropped message and feeds that restart themselves when they stall.
      <a class="link-arrow" href={caseHref}>Read the case study <Icon name="arrow" size={14} /></a>
    </p>
  </div>
</section>

<style>
  .market-grid {
    display: grid;
    grid-template-columns: minmax(0, 1.65fr) minmax(0, 1fr);
    gap: var(--space-5);
    align-items: start;
  }
  .panel {
    border-radius: var(--radius-lg);
    border: 1px solid var(--border);
    background: linear-gradient(180deg, rgba(255, 255, 255, 0.035), rgba(255, 255, 255, 0.012));
    overflow: hidden;
  }
  .panel-head {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: var(--space-2) var(--space-4);
    min-height: 48px;
    padding: var(--space-3) var(--space-5);
    border-bottom: 1px solid var(--border);
    font-family: var(--mono);
    font-size: var(--fs-xs);
    color: var(--text-3);
  }
  .feed {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    color: var(--text-2);
  }
  .live-dot {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--up);
    box-shadow: 0 0 0 0 rgba(61, 220, 151, 0.6);
    animation: lm-ping 2s var(--ease) infinite;
  }
  .rate {
    min-width: 12ch;
    font-variant-numeric: tabular-nums;
  }
  .state {
    margin-left: auto;
    display: inline-flex;
    align-items: center;
    height: 24px;
    padding: 0 10px;
    border-radius: 999px;
    border: 1px solid rgba(61, 220, 151, 0.3);
    background: rgba(61, 220, 151, 0.08);
    color: var(--up);
    white-space: nowrap;
    transition: color 0.3s, background 0.3s, border-color 0.3s;
  }
  .market[data-phase="burst"] .state {
    color: var(--accent-3);
    border-color: rgba(245, 165, 36, 0.4);
    background: rgba(245, 165, 36, 0.1);
  }
  .market[data-phase="draining"] .state {
    color: #c9c1ff;
    border-color: rgba(139, 124, 255, 0.4);
    background: rgba(139, 124, 255, 0.12);
  }

  .chart {
    position: relative;
    height: clamp(260px, 32vw, 360px);
    margin: var(--space-4) var(--space-5) 0;
  }
  .chart canvas,
  .chart-fallback {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    max-width: none;
  }
  .market.is-live .chart-fallback {
    display: none;
  }

  .legend {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2) var(--space-4);
    margin: 0;
    padding: var(--space-4) var(--space-5) 0;
    list-style: none;
    font-size: var(--fs-xs);
    color: var(--text-3);
  }
  .legend li {
    display: inline-flex;
    align-items: center;
    gap: 6px;
  }
  .sw {
    display: inline-block;
    width: 12px;
    height: 3px;
    border-radius: 2px;
  }
  .sw-price { background: var(--accent-2); }
  .sw-rate { height: 10px; width: 6px; background: rgba(139, 124, 255, 0.6); }
  .sw-burst { height: 10px; width: 6px; background: var(--accent-3); }
  .sw-queue { background: var(--text); }

  .panel-foot {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-3);
    padding: var(--space-5);
  }
  .burst-btn[aria-disabled="true"] {
    opacity: 0.7;
    cursor: progress;
  }
  .sim-tag {
    display: inline-flex;
    align-items: center;
    height: 22px;
    padding: 0 8px;
    border-radius: 6px;
    border: 1px dashed var(--border-2);
    font-family: var(--mono);
    font-size: var(--fs-xs);
    color: var(--text-3);
    white-space: nowrap;
  }

  .side {
    display: grid;
    gap: var(--space-5);
  }
  .tiles {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--space-3);
    margin: 0;
  }
  .tile {
    display: grid;
    align-content: start;
    gap: var(--space-2);
    padding: var(--space-4);
    border-radius: var(--radius);
    border: 1px solid var(--border);
    background: var(--surface);
  }
  .tile dt {
    font-size: var(--fs-xs);
    color: var(--text-3);
  }
  .tile dd {
    display: grid;
    gap: var(--space-2);
    margin: 0;
  }
  .tile-value {
    display: flex;
    align-items: baseline;
    gap: 4px;
    font-family: var(--mono);
    font-size: var(--fs-h3);
    font-weight: 600;
    letter-spacing: -0.02em;
    color: var(--text);
    font-variant-numeric: tabular-nums;
    white-space: nowrap;
  }
  .tile-value small {
    font-size: var(--fs-xs);
    font-weight: 500;
    color: var(--text-3);
  }
  .tile-sub {
    font-size: var(--fs-xs);
    line-height: 1.4;
    color: var(--text-3);
  }
  .tile--dropped .tile-value {
    color: var(--up);
  }
  .market[data-phase="burst"] .tile--latency .tile-value,
  .market[data-phase="draining"] .tile--latency .tile-value {
    color: var(--accent-3);
  }
  .meter {
    position: relative;
    display: block;
    height: 6px;
    border-radius: 999px;
    background: rgba(255, 255, 255, 0.06);
    overflow: hidden;
  }
  .meter span {
    position: absolute;
    inset: 0;
    border-radius: inherit;
    background: linear-gradient(90deg, var(--accent-2), var(--accent) 60%, var(--accent-3));
    transform-origin: left center;
    transition: transform 0.2s linear;
  }

  .tape {
    display: grid;
    height: calc(8 * 30px);
    margin: 0;
    padding: var(--space-2) 0;
    overflow: hidden;
    list-style: none;
    font-family: var(--mono);
    font-size: var(--fs-xs);
    font-variant-numeric: tabular-nums;
    align-content: start;
  }
  .tape :global(li) {
    display: grid;
    grid-template-columns: 4.5ch 5.5ch 5.5ch minmax(0, 1fr) 6ch 3ch;
    gap: var(--space-2);
    align-items: center;
    height: 30px;
    padding: 0 var(--space-5);
    color: var(--text-2);
    white-space: nowrap;
  }
  .tape :global(li.is-new) {
    animation: lm-in 0.6s var(--ease);
  }
  .tape :global(.t-sym) { color: var(--text); font-weight: 600; }
  .tape :global(.t-exp),
  .tape :global(.t-kind) { color: var(--text-3); }
  .tape :global(.t-k.is-call) { color: var(--up); }
  .tape :global(.t-k.is-put) { color: var(--down); }
  .tape :global(.t-prem) { color: var(--text); text-align: right; }
  .tape :global(.t-side) { text-align: right; }
  .tape :global(.t-side.is-ask) { color: var(--up); }
  .tape :global(.t-side.is-bid) { color: var(--down); }
  .tape :global(.t-side.is-mid) { color: var(--text-3); }

  .market-foot {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: var(--space-2) var(--space-4);
    margin-top: var(--space-6);
    max-width: 820px;
    font-size: var(--fs-sm);
    color: var(--text-3);
  }

  @keyframes lm-ping {
    70% { box-shadow: 0 0 0 6px rgba(61, 220, 151, 0); }
    100% { box-shadow: 0 0 0 0 rgba(61, 220, 151, 0); }
  }
  @keyframes lm-in {
    from { background: rgba(139, 124, 255, 0.16); opacity: 0; transform: translateY(-6px); }
    40% { opacity: 1; transform: none; }
    to { background: transparent; }
  }

  @media (max-width: 1000px) {
    .market-grid {
      grid-template-columns: minmax(0, 1fr);
    }
    .side {
      grid-template-columns: repeat(auto-fit, minmax(min(100%, 320px), 1fr));
      align-items: start;
    }
  }
  @media (max-width: 640px) {
    .chart {
      margin-inline: var(--space-3);
    }
    .panel-head,
    .legend,
    .panel-foot {
      padding-inline: var(--space-4);
    }
    .tape :global(li) {
      padding: 0 var(--space-4);
      gap: 6px;
    }
    .burst-btn {
      flex: 1 1 100%;
    }
    .state {
      margin-left: 0;
    }
  }
  @media (max-width: 400px) {
    .tiles {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>

<script>
  import { initLiveMarket } from "../../scripts/live-market";
  initLiveMarket();
</script>
