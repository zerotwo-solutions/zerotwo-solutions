---
// ⌘K / Ctrl+K command menu (Linear-style). Static list, filtered client-side.
import { nav, services, caseStudies, company } from "../data/site";
const items = [
  { group: "Navigate", label: "Home", href: "/" },
  ...nav.map((n) => ({ group: "Navigate", label: n.label, href: n.href })),
  { group: "Navigate", label: "Contact", href: "/contact/" },
  ...services.map((s) => ({ group: "Services", label: s.title, href: `/services/${s.slug}/` })),
  ...caseStudies.map((c) => ({ group: "Case studies", label: c.title, href: `/work/${c.slug}/` })),
  { group: "Actions", label: "Book a discovery call", href: "/contact/" },
  { group: "Actions", label: `Email ${company.email}`, href: `mailto:${company.email}` },
  { group: "Actions", label: "Estimate my project", href: "/#estimator" },
];
---
<dialog class="palette" data-palette aria-label="Command menu">
  <div class="palette-box">
    <input class="palette-input" type="text" placeholder="Search pages, services, case studies…" aria-label="Search" autocomplete="off" spellcheck="false" data-palette-input />
    <ul class="palette-list" role="listbox" data-palette-list>
      {items.map((it) => (
        <li role="option" aria-selected="false" data-group={it.group} data-label={it.label.toLowerCase()}>
          <a href={it.href}><span class="pg">{it.group}</span>{it.label}</a>
        </li>
      ))}
    </ul>
    <p class="palette-empty" hidden data-palette-empty>No results.</p>
    <footer class="palette-foot"><kbd>↑</kbd><kbd>↓</kbd> navigate <kbd>↵</kbd> open <kbd>esc</kbd> close</footer>
  </div>
</dialog>
<style>
  .palette { padding: 0; border: 0; background: transparent; width: min(640px, calc(100vw - 32px)); margin-top: 12vh; color: var(--text); }
  .palette::backdrop { background: rgba(0,0,0,.6); backdrop-filter: blur(4px); }
  .palette-box { border-radius: 16px; border: 1px solid var(--border-2); background: rgba(16,17,21,.96); box-shadow: 0 30px 80px -20px rgba(0,0,0,.8); overflow: hidden; }
  .palette-input { width: 100%; height: 56px; padding: 0 20px; border: 0; border-bottom: 1px solid var(--border); background: transparent; font-size: 1rem; outline: none; }
  .palette-list { list-style: none; margin: 0; padding: 8px; max-height: 50vh; overflow-y: auto; }
  .palette-list a { display: flex; align-items: center; gap: 12px; padding: 10px 12px; border-radius: 8px; font-size: var(--fs-sm); color: var(--text-2); }
  .palette-list [aria-selected="true"] a { background: var(--surface-2); color: var(--text); }
  .pg { min-width: 96px; font-family: var(--mono); font-size: 11px; text-transform: uppercase; letter-spacing: .05em; color: var(--text-3); }
  .palette-empty { padding: 24px; text-align: center; color: var(--text-3); }
  .palette-foot { display: flex; gap: 6px; align-items: center; padding: 10px 16px; border-top: 1px solid var(--border); font-size: 12px; color: var(--text-3); }
  kbd { font-family: var(--mono); font-size: 11px; padding: 2px 6px; border-radius: 4px; border: 1px solid var(--border-2); }
</style>
<script>
  const dlg = document.querySelector<HTMLDialogElement>("[data-palette]");
  const input = document.querySelector<HTMLInputElement>("[data-palette-input]");
  const options = Array.from(document.querySelectorAll<HTMLLIElement>("[data-palette-list] li"));
  const empty = document.querySelector<HTMLElement>("[data-palette-empty]");
  let active = 0;
  const visible = () => options.filter((o) => !o.hidden);
  const select = (i: number) => {
    const v = visible();
    options.forEach((o) => o.setAttribute("aria-selected", "false"));
    if (!v.length) return;
    active = (i + v.length) % v.length;
    v[active].setAttribute("aria-selected", "true");
    v[active].scrollIntoView({ block: "nearest" });
  };
  const open = () => {
    if (!dlg || dlg.open) return;
    dlg.showModal();
    if (input) input.value = "";
    options.forEach((o) => (o.hidden = false));
    if (empty) empty.hidden = true;
    select(0);
    input?.focus();
  };
  document.addEventListener("keydown", (e) => {
    if ((e.metaKey || e.ctrlKey) && e.key.toLowerCase() === "k") {
      e.preventDefault();
      if (dlg?.open) dlg.close(); else open();
    }
  });
  document.querySelectorAll("[data-palette-open]").forEach((b) => b.addEventListener("click", open));
  dlg?.addEventListener("click", (e) => { if (e.target === dlg) dlg.close(); });
  input?.addEventListener("input", () => {
    const q = input.value.trim().toLowerCase();
    options.forEach((o) => (o.hidden = !!q && !(o.dataset.label ?? "").includes(q) && !(o.dataset.group ?? "").toLowerCase().includes(q)));
    if (empty) empty.hidden = visible().length > 0;
    select(0);
  });
  input?.addEventListener("keydown", (e) => {
    if (e.key === "ArrowDown") { e.preventDefault(); select(active + 1); }
    else if (e.key === "ArrowUp") { e.preventDefault(); select(active - 1); }
    else if (e.key === "Enter") { e.preventDefault(); visible()[active]?.querySelector("a")?.click(); dlg?.close(); }
  });
</script>
