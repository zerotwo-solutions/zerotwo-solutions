---
import { nav, company } from "../data/site";
import Logo from "./Logo.astro";
import Icon from "./Icon.astro";
const path = Astro.url.pathname;
const isActive = (href: string) => path === href || path.startsWith(href);
---
<header class="nav" data-nav>
  <div class="container nav-inner">
    <a href="/" class="brand" aria-label={`${company.name} home`}>
      <Logo /><span>{company.shortName}<span class="brand-dim"> Solutions</span></span>
    </a>
    <nav aria-label="Primary" class="nav-links">
      <ul role="list">
        {nav.map((n) => (
          <li><a href={n.href} aria-current={isActive(n.href) ? "page" : undefined}>{n.label}</a></li>
        ))}
      </ul>
    </nav>
    <div class="nav-actions">
      <button class="kbd-btn" type="button" data-palette-open aria-label="Open command menu">
        <Icon name="command" size={14} /><span>K</span>
      </button>
      <a href="/contact/" class="btn btn--primary nav-cta">Book a call</a>
      <button class="menu-btn" type="button" aria-label="Open menu" aria-expanded="false" aria-controls="mobile-menu" data-menu-toggle>
        <Icon name="menu" size={22} />
      </button>
    </div>
  </div>
  <div id="mobile-menu" class="mobile-menu" hidden>
    <ul role="list" class="container">
      {nav.map((n) => <li><a href={n.href}>{n.label}</a></li>)}
      <li><a href="/contact/" class="btn btn--primary btn--lg">Book a call</a></li>
    </ul>
  </div>
</header>

<style>
  .nav { position: sticky; top: 0; z-index: 50; height: var(--nav-h); border-bottom: 1px solid transparent; transition: background .3s, border-color .3s, backdrop-filter .3s; }
  .nav.is-scrolled, .nav.is-open { background: rgba(8, 9, 10, .72); backdrop-filter: saturate(160%) blur(16px); -webkit-backdrop-filter: saturate(160%) blur(16px); border-bottom-color: var(--border); }
  .nav-inner { height: 100%; display: flex; align-items: center; justify-content: space-between; gap: 24px; }
  .brand { display: inline-flex; align-items: center; gap: 10px; font-weight: 640; letter-spacing: -0.02em; font-size: 1.0625rem; }
  .brand-dim { color: var(--text-3); font-weight: 500; }
  .nav-links ul { display: flex; gap: 4px; }
  .nav-links a { display: inline-flex; padding: 8px 12px; border-radius: 8px; font-size: var(--fs-sm); color: var(--text-2); transition: color .2s, background .2s; }
  .nav-links a:hover, .nav-links a[aria-current] { color: var(--text); background: var(--surface-2); }
  .nav-actions { display: flex; align-items: center; gap: 10px; }
  .nav-cta { height: 36px; padding: 0 14px; font-size: var(--fs-xs); }
  .kbd-btn { display: inline-flex; align-items: center; gap: 2px; height: 32px; padding: 0 10px; border-radius: 8px; border: 1px solid var(--border); color: var(--text-3); font-family: var(--mono); font-size: var(--fs-xs); }
  .kbd-btn:hover { color: var(--text); border-color: var(--border-2); }
  .menu-btn { display: none; padding: 8px; color: var(--text); }
  .mobile-menu { border-top: 1px solid var(--border); background: rgba(8,9,10,.96); }
  .mobile-menu ul { display: grid; gap: 4px; padding-block: 16px 24px; }
  .mobile-menu a:not(.btn) { display: block; padding: 12px 4px; font-size: 1.125rem; border-bottom: 1px solid var(--border); }
  .mobile-menu .btn { margin-top: 12px; width: 100%; }
  @media (max-width: 860px) {
    .nav-links, .nav-cta, .kbd-btn { display: none; }
    .menu-btn { display: inline-flex; }
  }
</style>
