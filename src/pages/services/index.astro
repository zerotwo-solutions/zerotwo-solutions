---
import Base from "../../layouts/Base.astro";
import Breadcrumbs from "../../components/Breadcrumbs.astro";
import SectionHeader from "../../components/SectionHeader.astro";
import ServiceCard from "../../components/ServiceCard.astro";
import CtaBand from "../../components/CtaBand.astro";
import Icon from "../../components/Icon.astro";
import { services, guarantees, stack, company } from "../../data/site";
import { abs, breadcrumbSchema, ORG_ID } from "../../lib/seo";

const crumbs = [
  { name: "Home", path: "/" },
  { name: "Services", path: "/services/" },
];

const guaranteeIcons = ["code", "lock", "clock", "play", "users", "shield"];

const schema = [
  breadcrumbSchema(crumbs),
  {
    "@type": "ItemList",
    "@id": `${abs("/services/")}#services`,
    name: `${company.name} services`,
    numberOfItems: services.length,
    itemListElement: services.map((s, i) => ({
      "@type": "ListItem",
      position: i + 1,
      item: {
        "@type": "Service",
        "@id": `${abs(`/services/${s.slug}/`)}#service`,
        name: s.title,
        url: abs(`/services/${s.slug}/`),
        description: s.short,
        provider: { "@id": ORG_ID },
        areaServed: { "@type": "Country", name: "United States" },
      },
    })),
  },
];
---
<Base
  title="AI, FinTech & SaaS Development Services"
  description="AI agent development, MCP servers, real-time FinTech and market data platforms, SaaS on AWS and voice AI, built by a senior team for US startups and scale-ups."
  schema={schema}
>
  <section class="section svc-hero">
    <div class="grid-bg" aria-hidden="true"></div>
    <div class="container svc-hero-inner">
      <Breadcrumbs items={crumbs} />
      <span class="eyebrow">Services</span>
      <h1 class="h1">AI, FinTech and SaaS <span class="gradient-text">engineering services</span></h1>
      <p class="lead">
        We design, build and run production software: AI agents and MCP servers, real-time market data platforms, voice
        assistants and multi-tenant SaaS on AWS. One senior team takes you from architecture to production, and stays to
        run what we ship.
      </p>
      <div class="hero-actions">
        <a class="btn btn--primary btn--lg" href="/contact/">Get your free roadmap <Icon name="arrow" size={16} class="arrow" /></a>
        <a class="btn btn--lg" href="/work/">See case studies</a>
      </div>
    </div>
  </section>

  <section class="section section--border" aria-labelledby="all-services">
    <div class="container">
      <h2 id="all-services" class="sr-only">All services</h2>
      <ul class="grid grid-3 svc-grid" role="list">
        {services.map((s, i) => (
          <li data-reveal style={`--reveal-delay:${(i % 3) * 80}ms`}>
            <ServiceCard service={s} index={i} />
          </li>
        ))}
      </ul>
    </div>
  </section>

  <section class="section section--border">
    <div class="container">
      <SectionHeader
        eyebrow="How we engage"
        title="Terms built for US product teams"
        lead={`Start with a ${company.roadmapTime} technical roadmap and a fixed-scope pilot. Every engagement runs on the same commitments.`}
      />
      <ul class="grid grid-3 engage-grid" role="list">
        {guarantees.slice(0, 6).map((g, i) => (
          <li class="engage-item">
            <span class="engage-icon" aria-hidden="true"><Icon name={guaranteeIcons[i] ?? "check"} size={18} /></span>
            <div>
              <h3 class="engage-title">{g.title}</h3>
              <p class="engage-body">{g.body}</p>
            </div>
          </li>
        ))}
      </ul>
      <p class="engage-more">
        <a class="link-arrow" href="/process/">See how a project runs, step by step <Icon name="arrow" size={16} /></a>
      </p>
    </div>
  </section>

  <section class="section section--border">
    <div class="container">
      <SectionHeader
        eyebrow="Technology"
        title="The stack we ship to production"
        lead="Proven tools, chosen per workload. We stay provider-independent where it matters, so you can switch models or vendors without a rewrite."
      />
      <div class="stack-groups" data-reveal>
        {stack.map((g) => (
          <div class="stack-row">
            <h3 class="stack-title">{g.group}</h3>
            <ul class="tag-list" role="list">
              {g.items.map((t) => <li class="tag">{t}</li>)}
            </ul>
          </div>
        ))}
      </div>
    </div>
  </section>

  <CtaBand title="Not sure which service fits?" lead={`Describe the product you want to ship. You will get a technical roadmap and a fixed-scope proposal within ${company.roadmapTime}.`} />
</Base>

<style>
  .svc-hero {
    overflow: hidden;
    padding-bottom: calc(var(--section-y) * 0.6);
  }
  .svc-hero-inner {
    position: relative;
    display: grid;
    justify-items: start;
    gap: var(--space-5);
  }
  .svc-hero-inner .h1 {
    max-width: 18ch;
  }
  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
    margin-top: var(--space-2);
  }
  .svc-grid > li {
    display: flex;
  }
  .svc-grid > li > :global(*) {
    flex: 1;
  }

  .engage-grid {
    gap: 0;
    border-top: 1px solid var(--border);
    border-left: 1px solid var(--border);
    border-radius: var(--radius-lg);
    overflow: hidden;
  }
  .engage-item {
    display: flex;
    gap: var(--space-4);
    padding: var(--space-6);
    border-right: 1px solid var(--border);
    border-bottom: 1px solid var(--border);
    background: var(--surface);
  }
  .engage-icon {
    flex: none;
    display: inline-grid;
    place-items: center;
    width: 36px;
    height: 36px;
    border-radius: var(--radius-sm);
    border: 1px solid var(--border-2);
    color: var(--accent-2);
  }
  .engage-title {
    font-size: var(--fs-body);
    font-weight: 590;
    letter-spacing: var(--tracking-snug);
    line-height: 1.4;
  }
  .engage-body {
    margin-top: var(--space-1);
    font-size: var(--fs-sm);
    color: var(--text-2);
  }
  .engage-more {
    margin-top: var(--space-6);
  }

  .stack-groups {
    border-top: 1px solid var(--border);
  }
  .stack-row {
    display: grid;
    grid-template-columns: minmax(0, 220px) minmax(0, 1fr);
    gap: var(--space-5);
    align-items: center;
    padding-block: var(--space-5);
    border-bottom: 1px solid var(--border);
  }
  .stack-title {
    font-family: var(--mono);
    font-size: var(--fs-xs);
    font-weight: 500;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--text-3);
    line-height: 1.4;
  }
  @media (max-width: 720px) {
    .stack-row {
      grid-template-columns: 1fr;
      gap: var(--space-3);
    }
    .engage-item {
      padding: var(--space-5);
    }
  }
</style>
