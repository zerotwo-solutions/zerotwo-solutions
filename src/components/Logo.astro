---
// Official ZeroTwo logo (dark-UI variant generated from public/assets/img/newLogo1.svg by `npm run og`).
// "compact" omits the tagline for the navbar; "full" keeps it.
interface Props { variant?: "compact" | "full"; height?: number; eager?: boolean }
const { variant = "compact", height = 36, eager = false } = Astro.props;
const src = variant === "full" ? "/brand/logo-dark.webp" : "/brand/logo-dark-compact.webp";
const ratio = variant === "full" ? 477 / 160 : 357 / 120;
---
<img
  src={src}
  width={Math.round(height * ratio)}
  height={height}
  alt="ZeroTwo Solutions"
  decoding="async"
  loading={eager ? "eager" : "lazy"}
  fetchpriority={eager ? "high" : "auto"}
/>
